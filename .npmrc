# This setting is for npm.
#
# package.json says this project needs a package manager called "please-use-pnpm"
# (see the "engines" block). No npm version can satisfy that, and the line below
# turns the mismatch into an error. The result: "npm install" stops immediately
# in this folder, before it can create files that confuse pnpm.
#
# Use "pnpm install" instead.
engine-strict=true
